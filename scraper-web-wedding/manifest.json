{
  "manifest_version": 3,
  "name": "Scraper Web Wedding - Batch Forensic Cloner",
  "version": "1.3.0",
  "description": "Ekstensi cerdas kloning website undangan pernikahan: Batch Multi-URL queue, tangkap Cover utuh, download isi lengkap, pisahkan folder music/fonts/images, dan auto-exit fullscreen.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Buka Scraper Web Wedding Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
